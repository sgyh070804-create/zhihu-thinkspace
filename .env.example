# ============ ThinkSpace 本地服务 ============
THINKSPACE_API_URL=http://localhost:8000
THINKSPACE_WEB_URL=http://localhost:5173
# 用于加密本地会话与 OAuth token 的随机长字符串；每个环境必须不同
THINKSPACE_SECRET_KEY=replace-with-a-long-random-local-secret
THINKSPACE_ENABLE_DEMO=true
THINKSPACE_SECURE_COOKIE=false
# 本地 SQLite 数据库（已被 .gitignore 忽略，不会提交）
# THINKSPACE_DATABASE_PATH=

# ============ 知乎开放平台 ============
# Access Secret：https://developer.zhihu.com/profile 登录后申请
# 每个开发者用自己的；只放 .env，绝不提交到 Git
ZHIHU_ACCESS_SECRET=

# ============ 知乎 OAuth 应用凭证（赛事分配） ============
# ⚠️ 按赛事手册：报名 → 组队 → 创建项目（2026-12-05 10:00 开启）→ 赛事页面分配 App ID / App Key
# 拿到后填入下面两行并重启后端，网页"使用知乎账号登录"即生效。
# 登记回调地址时必须与下方 REDIRECT_URI 完全一致。
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/zhihu/callback
